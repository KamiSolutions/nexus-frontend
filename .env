# EXPO_PUBLIC_API_URL must point at nexus-api-gateway (the single entry
# point for every backend call this app makes — auth, financials, hr,
# fleet, cases, claims, leases, audit, and the platform-service Overview).
# http://localhost:8000 matches nexus-api-gateway's README ("uvicorn
# app.main:app --reload --port 8000"). Point it at a real deployed gateway
# URL for staging/production.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_TENANT_MODE=multi
